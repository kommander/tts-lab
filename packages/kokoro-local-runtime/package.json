{
  "name": "kokoro-local-runtime",
  "version": "0.1.0",
  "private": true,
  "license": "MIT AND Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./fluidaudio": {
      "types": "./dist/fluidaudio/index.d.ts",
      "import": "./dist/fluidaudio/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "resources/kokoro_worker.py",
    "swift/Package.swift",
    "swift/Package.resolved",
    "swift/Sources/TtsLabFluidAudio/main.swift",
    "voices",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "THIRD_PARTY_NOTICES",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "test": "bun test tests && node --test tests/*.test.mjs tests/core/*.test.mjs tests/fluidaudio/*.test.mjs",
    "check:python": "python3 -m py_compile resources/kokoro_worker.py"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "phonemizer": "1.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.2"
  }
}
